# Copy this file to backend/.env for local development.
# Do not commit backend/.env or any real credential.

# Optional for a local desktop install. If blank, ULTRON creates a private
# random secret in its app-data directory. Set an explicit long random value
# for a managed or deployed installation.
ULTRON_AUTH_SECRET=

# Local Ollama endpoint and model names. Install the default model with:
#   ollama pull llama3.2
# Any compatible model installed in Ollama can be selected here.
ULTRON_OLLAMA_URL=http://127.0.0.1:11434/api/chat
ULTRON_OLLAMA_MODEL=llama3.2
ULTRON_MEMORY_MODEL=llama3.2

# Leave true for a personal local installation. Managed installations can turn
# this off after the intended accounts have been created.
ULTRON_AUTH_ALLOW_REGISTRATION=true

# Advanced account policy. These defaults are suitable for a local desktop
# install. On a managed deployment, require verified email only when SMTP is
# configured and keep the auth secret outside version control.
ULTRON_AUTH_REQUIRE_EMAIL_VERIFICATION=false
ULTRON_AUTH_PASSWORD_MIN_LENGTH=12
ULTRON_AUTH_SESSION_TTL_DAYS=30
ULTRON_AUTH_EMAIL_TOKEN_TTL_MINUTES=60
ULTRON_AUTH_RATE_WINDOW_SECONDS=900
ULTRON_AUTH_LOGIN_ATTEMPT_LIMIT=8
ULTRON_AUTH_RESET_ATTEMPT_LIMIT=5

# Optional local data locations. Leave empty for ~/.ultron. These are useful
# for a managed test machine; never point them at a shared or synced folder.
ULTRON_DATA_DIR=
ULTRON_AUTH_DATA_DIR=
ULTRON_AUTH_DB_PATH=
ULTRON_AUTH_SECRET_FILE=

# Keep FastAPI documentation off in normal local/package launches. It is only
# intended for controlled backend development.
ULTRON_ENABLE_API_DOCS=false

# Optional Nominatim-compatible HTTPS endpoint used only after a person clicks
# Find on Globe in Settings. Leave the default to use OpenStreetMap Nominatim.
# Lookups are rate-limited and cached in process memory only; a confirmed
# position is stored separately in the signed-in local account's preferences.
ULTRON_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Optional SMTP transport for account verification and password-reset mail.
# ULTRON emails a one-time code that the person pastes back into the app; no
# public URL or browser link is needed. Leave all SMTP values empty to run
# fully offline with local accounts.
# ULTRON requires encrypted account mail by default. Use either implicit SSL
# (normally port 465) or STARTTLS (normally port 587). SMTP credentials always
# require one of these TLS options.
ULTRON_SMTP_HOST=
ULTRON_SMTP_PORT=587
ULTRON_SMTP_USERNAME=
ULTRON_SMTP_PASSWORD=
ULTRON_SMTP_FROM=
ULTRON_SMTP_USE_SSL=false
ULTRON_SMTP_STARTTLS=true
ULTRON_SMTP_REQUIRE_TLS=true

# Optional Fish Audio text-to-speech.
FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free
